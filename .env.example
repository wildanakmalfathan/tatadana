# ==========================================
# TATADANA ENVIRONMENT CONFIGURATION
# ==========================================

# Base URL (Digunakan untuk setWebhook Telegram dan generate callback link)
WEBHOOK_BASE_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=tatadana-exports

# Telegram Bot (Shared Single Bot untuk seluruh user)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# AI Providers (Default fallback & admin credentials)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Payment Gateway (Midtrans Sandbox / Production)
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_IS_PRODUCTION=false

# Security & Data Encryption (AES-256 Key untuk token bot & API key di database)
DATA_ENCRYPTION_KEY=32_characters_random_encryption_key_here!
ADMIN_SECRET_PIN=889900
